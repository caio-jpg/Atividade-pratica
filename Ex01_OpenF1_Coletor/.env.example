# Copie para ".env" e ajuste.
# Local:   mongodb://localhost:27017
# Atlas:   mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=openf1_data
OPENF1_BASE_URL=https://api.openf1.org/v1

# Sessões a coletar (separadas por vírgula).
# 9157 = Corrida do GP da Itália 2023 (Monza). O enunciado cita 9159, que na API
# atual é o Treino Livre 2 de Singapura. Ex.: SESSION_KEYS=9157,9165,9205
SESSION_KEYS=9157

REQUEST_TIMEOUT=30
MAX_RETRIES=3
