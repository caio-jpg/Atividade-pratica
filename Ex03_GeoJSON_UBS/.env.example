MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=dados_abertos_geo
MONGO_COLLECTION=ubs
# Recurso CSV de UBS no portal de dados abertos. Se o link mudar, busque "UBS CSV"
# em https://dados.gov.br, abra o recurso CSV e copie a URL de download.
UBS_CSV_URL=https://repositorio.dados.gov.br/saude/unidades-saude/unidade-basica-saude/ubs.csv
PASTA_DADOS=dados
REQUEST_TIMEOUT=120
